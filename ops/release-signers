# The public half of the release signing key (ssh-keygen -Y, namespace "git"): ops/bannerfall-update
# and the auto-update install a release only when its tag is signed by a key listed here.
# One line per key:   bannerfall-releases namespaces="git" ssh-ed25519 AAAA…
# A new release may replace this file (a key change, signed by the old key); the next update checks
# against the new one. With no key line here a tag is not checked, and the update says so.
bannerfall-releases namespaces="git" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIH7TeXAugUvqmHrDTY3mf4mk1dU6hEuGW3vUbFYC6blc
