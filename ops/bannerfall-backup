#!/usr/bin/env bash
# bannerfall-backup – dumps the production database into backups/bannerfall-<date>-<time>.sql.gz
# and deletes dumps older than 14 days (docs/plan/01-architecture.md §8, README "Backups").
#
# Run it from anywhere on the server; it works in the folder that holds compose.prod.yaml. Daily
# via cron (see the README):
#   17 3 * * * /opt/bannerfall/ops/bannerfall-backup >> /opt/bannerfall/backups/backup.log 2>&1
#
# BACKUP_DIR: where the dumps go (default: backups/ next to compose.prod.yaml)
# KEEP_DAYS:  how long to keep them (default 14)
# BACKUP_AGE_RECIPIENT and BACKUP_OFFSITE_CMD: optional, an encrypted copy of every dump in a
#   second place, for a server that dies with its disk (README "Backups"). The dump is encrypted
#   with age (https://age-encryption.org, `apt install age`) to the PUBLIC key in
#   BACKUP_AGE_RECIPIENT ("age1…", from `age-keygen`; the server never holds the key that opens
#   it), and BACKUP_OFFSITE_CMD is run with the encrypted file as its argument "$1", for example
#     BACKUP_AGE_RECIPIENT=age1… BACKUP_OFFSITE_CMD='rsync -e "ssh -i /root/.ssh/backup" "$1" backup@other-host:bannerfall/'
#     BACKUP_OFFSITE_CMD='rclone copyto "$1" remote:bannerfall/"$(basename "$1")"'
#   Nothing is ever sent unencrypted: the command without the recipient is refused. The copy is
#   made after the local dump is safe; if it fails, the run exits 1 and reports /fail, and the
#   local dump stays. Old copies are not deleted (that is the other place's job, for instance a
#   lifecycle rule). bannerfall-update and bannerfall-restore make no copy (BACKUP_OFFSITE_CMD is
#   empty there), so an unreachable second place never holds an update up.
# BACKUP_PING_URL: optional, the address of a free "dead man's switch" check (for example a
#   healthchecks.io check). A good backup requests the address, a failed one requests it with
#   /fail added, and the service mails you when neither happens in time. Put it in front of the
#   command in cron: 17 3 * * * BACKUP_PING_URL=https://hc-ping.com/<id> /opt/bannerfall/ops/...
set -euo pipefail
# A dump holds every account (password hashes included): readable for its owner only.
umask 077

cd "$(dirname "$0")/.."

# Tells the check service how it went; never makes the backup itself fail.
ping() {
  [ -z "${BACKUP_PING_URL:-}" ] || curl -fsS -m 10 --retry 2 -o /dev/null "${BACKUP_PING_URL%/}$1" || true
}

BACKUP_DIR="${BACKUP_DIR:-backups}"
KEEP_DAYS="${KEEP_DAYS:-14}"

# Look at the off-site settings first: a backup that would not be sent where it should be is
# reported before anything is dumped, not after.
if [ -n "${BACKUP_OFFSITE_CMD:-}" ]; then
  if [ -z "${BACKUP_AGE_RECIPIENT:-}" ]; then
    echo "$(date -Is) BACKUP_OFFSITE_CMD needs BACKUP_AGE_RECIPIENT: a dump is never sent unencrypted" >&2
    ping /fail
    exit 2
  fi
  if ! command -v age > /dev/null; then
    echo "$(date -Is) BACKUP_OFFSITE_CMD needs age (apt install age)" >&2
    ping /fail
    exit 2
  fi
fi
mkdir -p "$BACKUP_DIR"

target="$BACKUP_DIR/bannerfall-$(date +%F-%H%M).sql.gz"
partial="$target.part"
cleanup() {
  local status=$?
  rm -f "$partial"
  [ "$status" -eq 0 ] || ping /fail
}
trap cleanup EXIT

# --clean --if-exists: the dump can be loaded over an existing database too.
docker compose -f compose.prod.yaml exec -T db \
  pg_dump -U bannerfall --clean --if-exists --no-owner bannerfall | gzip > "$partial"

# A dump that is not a readable gzip file, or that has no game data in it, is not a backup.
# grep -c (not -q) on purpose: -q quits at the first match, gzip then dies from SIGPIPE while it
# still has data to write, and with pipefail that makes the check fail on any real-sized dump.
gzip -t "$partial"
if ! gzip -dc "$partial" | grep -c 'CREATE TABLE public.account ' > /dev/null; then
  echo "$(date -Is) backup failed: no account table in the dump" >&2
  exit 1
fi
mv "$partial" "$target"
trap - EXIT

find "$BACKUP_DIR" -maxdepth 1 -name 'bannerfall-*.sql.gz' -mtime "+$KEEP_DAYS" -delete
echo "$(date -Is) backup ok: $target ($(du -h "$target" | cut -f1))"

# The encrypted copy in a second place. The local dump is safe by now; a failure here is reported
# and makes the run fail, but takes nothing back.
if [ -n "${BACKUP_OFFSITE_CMD:-}" ]; then
  sealed_dir="$(mktemp -d "$BACKUP_DIR/.offsite.XXXXXX")"
  trap 'rm -rf "$sealed_dir"' EXIT
  sealed="$sealed_dir/$(basename "$target").age"
  if age -r "$BACKUP_AGE_RECIPIENT" -o "$sealed" "$target" \
    && bash -c "$BACKUP_OFFSITE_CMD" bannerfall-offsite "$sealed"; then
    echo "$(date -Is) off-site copy ok: $(basename "$sealed")"
  else
    echo "$(date -Is) OFF-SITE COPY FAILED (the local backup $target is fine)" >&2
    ping /fail
    exit 1
  fi
fi
ping ""
