# Copy to .env on the server (never commit .env) and fill in the values.
# docker compose -f compose.prod.yaml reads it from the same folder.

# The image to run: the version you pushed (docker build ... -t ghcr.io/your-name/bannerfall:1.0.0), or
# one you built on the server itself (docker build ... -t bannerfall:1.0.0 -> BANNERFALL_IMAGE=bannerfall:1.0.0).
BANNERFALL_IMAGE=bannerfall:latest

# Database password (any long random string: openssl rand -hex 24). Set it before the first start:
# the database keeps the password it was created with. Left empty on purpose: `docker compose`
# refuses to start until you fill it in, so no well-known password ever runs.
POSTGRES_PASSWORD=

# The host token for the command line bannerfall-admin: at least 32 characters, random
# (openssl rand -hex 24). The server refuses to start with a shorter one. Also left empty on
# purpose: whoever knows this token can run the whole host console.
BANNERFALL_ADMIN_TOKEN=

# vServer with automatic HTTPS: run Caddy and give it the domain (A/AAAA records point to the server).
# The world's own domain name (for example play.example.com).
COMPOSE_PROFILES=caddy
BANNERFALL_DOMAIN=play.example.com

# TrueNAS (or any other proxy): leave COMPOSE_PROFILES empty and point the proxy to the app's port.
# From another machine or container the port must not be limited to the host itself:
# APP_BIND=0.0.0.0

# Ports on the host (the defaults are shown; uncomment to change one).
# APP_PORT: the app itself, for a proxy other than Caddy (TrueNAS) or for bannerfall-admin from the
# host. HTTP_PORT / HTTPS_PORT: Caddy; Let's Encrypt needs 80 and 443 reachable from the internet,
# so only change them when a router forwards 80/443 to the new ports.
# APP_PORT=8461
# HTTP_PORT=80
# HTTPS_PORT=443

# Sites that may read the player counts of this world (GET /api/world/status) from the browser: the
# landing page. Comma-separated; the default is https://bannerfall.de and https://www.bannerfall.de.
# BANNERFALL_STATUS_ORIGINS=https://bannerfall.de,https://www.bannerfall.de

# Time zone of the container (log times, NPC quiet hours are Berlin time anyway).
TZ=Europe/Berlin
