# Copy to .env on the server (never commit .env) and fill in the values.
# docker compose -f compose.prod.yaml reads it from the same folder.

# The image to run: the version you pushed (docker build ... -t ghcr.io/your-name/bannerfall:1.0.0), or
# one you built on the server itself (docker build ... -t bannerfall:1.0.0 -> BANNERFALL_IMAGE=bannerfall:1.0.0).
BANNERFALL_IMAGE=bannerfall:latest

# Database password (any long random string: openssl rand -hex 24). Set it before the first start:
# the database keeps the password it was created with. Left empty on purpose: `docker compose`
# refuses to start until you fill it in, so no well-known password ever runs.
POSTGRES_PASSWORD=

# The host token for the command line bannerfall-admin: at least 32 characters, random
# (openssl rand -hex 24). The server refuses to start with a shorter one. Also left empty on
# purpose: whoever knows this token can run the whole host console.
BANNERFALL_ADMIN_TOKEN=

# vServer with automatic HTTPS: run Caddy and give it the domain (A/AAAA records point to the server).
# The world's own domain name (for example play.example.com).
COMPOSE_PROFILES=caddy
BANNERFALL_DOMAIN=play.example.com

# Several worlds on one server (docs/hosting.md section 12): every world but the first gets its own
# compose project name (its containers and volumes; never another world's name) and its own APP_PORT,
# leaves COMPOSE_PROFILES empty, and the shared Caddy in edge/ serves its domain.
# COMPOSE_PROJECT_NAME=bannerfall-two

# TrueNAS (or any other proxy): leave COMPOSE_PROFILES empty and point the proxy to the app's port.
# From another machine or container the port must not be limited to the host itself:
# APP_BIND=0.0.0.0

# Ports on the host (the defaults are shown; uncomment to change one).
# APP_PORT: the app itself, for a proxy other than Caddy (TrueNAS) or for bannerfall-admin from the
# host. HTTP_PORT / HTTPS_PORT: Caddy; Let's Encrypt needs 80 and 443 reachable from the internet,
# so only change them when a router forwards 80/443 to the new ports.
# APP_PORT=8461
# HTTP_PORT=80
# HTTPS_PORT=443

# Who runs this world, shown on the privacy page (/privacy, linked from login and registration).
# The name of the person or club responsible, possibly with a postal address, and how players reach
# you (usually an email address). Left empty, the page only explains what the game stores; the
# rules of your country may ask for a name and a contact.
BANNERFALL_OPERATOR_NAME=
BANNERFALL_OPERATOR_CONTACT=

# Logging in through an account server, an OpenID Connect provider where this world is registered
# as a client (docs/hosting.md, "Account server"). Leave the issuer empty for this world's own
# accounts only. MODE: OFF (own accounts only), LINKING (both; players may link their account) or
# REQUIRED (only the account server).
# BANNERFALL_ACCOUNT_SERVER_ISSUER=https://accounts.example.com
# BANNERFALL_ACCOUNT_SERVER_CLIENT_ID=
# BANNERFALL_ACCOUNT_SERVER_CLIENT_SECRET=
# BANNERFALL_ACCOUNT_SERVER_NAME=example.com
# BANNERFALL_ACCOUNT_SERVER_MODE=OFF
# CAREER=true: report the linked players' points, achievements and end result to the account
# server for their career page (only Bannerfall's own account server takes them).
# BANNERFALL_ACCOUNT_SERVER_CAREER=false

# Push notifications (docs/hosting.md, "Push notifications"): the world's key pair. Print one with
#   docker compose -f compose.prod.yaml exec -T app bannerfall-admin push keys >> .env
# and recreate the app (up -d). Left empty, the world sends no notifications. A new pair later makes
# every device sign up again (by itself, when the player next opens the game). SUBJECT: how the
# push services can reach you (mailto: or https); empty = BANNERFALL_OPERATOR_CONTACT if it is an
# email address.
# BANNERFALL_PUSH_PUBLIC_KEY=
# BANNERFALL_PUSH_PRIVATE_KEY=
# BANNERFALL_PUSH_SUBJECT=mailto:host@example.com

# Sites that may read the player counts of this world (GET /api/world/status) from the browser: the
# landing page. Comma-separated; the default is https://bannerfall.de and https://www.bannerfall.de.
# BANNERFALL_STATUS_ORIGINS=https://bannerfall.de,https://www.bannerfall.de

# Time zone of the container (log times, NPC quiet hours are Berlin time anyway).
TZ=Europe/Berlin
