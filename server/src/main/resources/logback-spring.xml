<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging (docs/plan/01-architecture.md §7, §8; M4d). Spring Boot's Logback, no extra library.

  - Console: Spring Boot's default, as before.
  - ${LOG_DIR}/server.log: INFO and up, with stack traces.
  - ${LOG_DIR}/server.err: WARN and ERROR only, with stack traces. Empty in normal play.
  Both roll daily and at 10 MB (server.2026-10-03.0.log, server.2026-10-03.0.err) and are kept
  14 days; at most 400 MB of old .log and 100 MB of old .err files (500 MB together).

  LOG_DIR = property bannerfall.logging.dir (application.yml: "logs" relative to the working
  directory, i.e. server/logs with bootRun; application-prod.yml: /app/logs).
  Tests use src/test/resources/logback-test.xml instead (console only), which Spring Boot prefers.
-->
<configuration>
    <!--
      Every line shows the request id (RequestIdFilter, MDC "requestId") or the event the worker is
      handling (EventProcessor, MDC "event"), e.g. "req=3f9a01c2 " or "event=42 "; nothing when
      neither is set. Defined before defaults.xml, whose console and file patterns use it.
    -->
    <property name="LOG_CORRELATION_PATTERN"
              value="%replace(req=%X{requestId} ){'^req= ', ''}%replace(event=%X{event} ){'^event= ', ''}"/>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty name="LOG_DIR" source="bannerfall.logging.dir" defaultValue="logs"/>

    <appender name="LOG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>${FILE_LOG_CHARSET}</charset>
        </encoder>
        <file>${LOG_DIR}/server.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/server.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>400MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <appender name="ERR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>${FILE_LOG_CHARSET}</charset>
        </encoder>
        <file>${LOG_DIR}/server.err</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/server.%d{yyyy-MM-dd}.%i.err</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOG_FILE"/>
        <appender-ref ref="ERR_FILE"/>
    </root>
</configuration>
